{
	"env": {
		"browser": true,
		"es2021": true
	},
	"extends": "next/core-web-vitals",
	"parserOptions": {
		"ecmaVersion": 6,
		"sourceType": "module",
		"ecmaFeatures": {
			"jsx": true
		}
	},
	"plugins": ["import"],
	"rules": {
		"react/display-name": [false, { "ignoreTranspilerName": true }]
	}
}
